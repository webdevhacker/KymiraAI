# ================================
# KymiraAI Backend Environment
# ================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/kymiraai

# JWT Secrets
JWT_SECRET=change_me_to_a_long_random_secret_string_here
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── AI Provider (OpenRouter) ──────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── Web Search ───────────────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ─── Image Generation ─────────────────────────────────────────────────────────
# Pollinations.ai — 100% FREE, no API key required

# ─── Email SMTP (For OTPs & Alerts) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@kymiraai.com

# CORS
CLIENT_URL=http://localhost:5173
